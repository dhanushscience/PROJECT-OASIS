{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OASIS",
  "version": "0.1.10",
  "identifier": "dev.oasis.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OASIS",
        "url": "app.html",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": false,
        "resizable": true,
        "maximized": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1QkVBMTNBQjg0RDJEMzkKUldRNUxVMjRPcUcrRlQyR2NRUkdPaTRxYnM3cW9KR3ZmWkV6bXYvVFY1TGQ3UGFibEdDV2xzVmQK",
      "endpoints": [
        "https://github.com/dhanushscience/PROJECT-OASIS/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
